<div style="font-family: Arial, Helvetica, sans-serif; background-color: #f4f6f8; padding: 40px 0;">
  <div style="max-width: 500px; margin: auto; background: #ffffff; padding: 30px; border-radius: 8px; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">

    <h2 style="margin-top: 0; color: #111827;">
      Hello <%= name %>,
    </h2>

    <p style="font-size: 14px; color: #4b5563; line-height: 1.5;">
      We received a request to reset the password for your account. Use the code below to set up a new password:
    </p>

    <div style="text-align: center; margin: 30px 0;">
      <span style="
        display: inline-block;
        padding: 12px 24px;
        font-size: 28px;
        font-weight: bold;
        letter-spacing: 6px;
        background-color: #f3f4f6;
        border-radius: 6px;
        color: #111827;
        border: 1px solid #e5e7eb;">
        <%= otp %>
      </span>
    </div>

    <p style="font-size: 13px; color: #6b7280; line-height: 1.4;">
      This password reset code is valid for <strong>5 minutes</strong>. Do not share this OTP with anyone.
    </p>

    <div style="margin-top: 25px; padding: 12px 16px; background-color: #fef2f2; border-left: 4px solid #ef4444; border-radius: 4px;">
      <p style="font-size: 13px; color: #991b1b; margin: 0; line-height: 1.4;">
        <strong>If you didn't request a password reset:</strong> Your account is still secure. You can safely ignore this email, and your password will remain unchanged.
      </p>
    </div>

    <hr style="margin: 30px 0; border: none; border-top: 1px solid #e5e7eb;" />

    <p style="font-size: 12px; color: #9ca3af; text-align: center; margin: 0;">
      © <%= new Date().getFullYear() %> One Arena. All rights reserved.
    </p>

  </div>
</div>