model ManagerProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  contactNumber String
  address       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("manager_profile")
}

model TurfManager {
  id          String                   @id @default(uuid())
  turfId      String
  managerId   String
  createdAt   DateTime                 @default(now())
  permissions ManagerPermissionGrant[]
  manager     User                     @relation(fields: [managerId], references: [id], onDelete: Cascade)
  turf        Turf                     @relation(fields: [turfId], references: [id], onDelete: Cascade)

  @@unique([turfId, managerId])
  @@index([turfId])
  @@index([managerId])
  @@map("turf_manager")
}

model ManagerPermissionGrant {
  id           String            @id @default(uuid())
  assignmentId String
  permission   ManagerPermission
  createdAt    DateTime          @default(now())
  assignment   TurfManager       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, permission])
  @@index([permission])
  @@map("manager_permission_grant")
}