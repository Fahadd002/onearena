model Turf {
  id          String     @id @default(uuid())
  ownerId     String
  categoryId  String
  name        String
  description String?
  address     String
  latitude    Decimal    @db.Decimal(13, 10)
  longitude   Decimal    @db.Decimal(13, 10)
  status      TurfStatus @default(ACTIVE)
  basePrice   Decimal    @db.Decimal(12, 2)
  slotMinutes Int        @default(90)
  timezone    String     @default("Asia/Dhaka")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  packages   Package[]
  reviews    Review[]
  facilities TurfFacility[]
  images     TurfImage[]
  managers   TurfManager[]
  priceRules TurfPriceRule[]
  slots      TurfSlot[]
  category   TurfCategory    @relation(fields: [categoryId], references: [id])
  owner      User            @relation(fields: [ownerId], references: [id])

  @@index([ownerId, status])
  @@index([categoryId, status])
  @@map("turf")
}

model TurfPriceRule {
  id          String   @id @default(uuid())
  turfId      String
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  price       Decimal  @db.Decimal(12, 2)
  active      Boolean  @default(true)
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  turf        Turf     @relation(fields: [turfId], references: [id], onDelete: Cascade)

  @@unique([turfId, dayOfWeek, startDate, endDate, startMinute, endMinute])
  @@index([turfId, dayOfWeek, startDate, endDate, startMinute, endMinute])
  @@map("turf_price_rule")
}

model TurfSlot {
  id          String    @id @default(uuid())
  turfId      String
  slotDate    DateTime  @db.Date
  startMinute Int
  endMinute   Int
  price       Decimal   @db.Decimal(12, 2)
  active      Boolean   @default(true)
  slotStatus  SlotSatus @default(AVAILABLE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  turf        Turf      @relation(fields: [turfId], references: [id], onDelete: Cascade)
  booking     Booking?

  @@unique([turfId, slotDate, startMinute, endMinute])
  @@index([turfId, slotDate, active])
  @@index([turfId, slotDate, slotStatus])
  @@map("turf_slot")
}

model TurfImage {
  id        String   @id @default(uuid())
  turfId    String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  turf      Turf     @relation(fields: [turfId], references: [id], onDelete: Cascade)

  @@index([turfId, sortOrder])
  @@map("turf_image")
}

model Package {
  id          String            @id @default(uuid())
  turfId      String
  name        String
  description String?
  price       Decimal           @db.Decimal(12, 2)
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  facilities  PackageFacility[]
  turf        Turf              @relation(fields: [turfId], references: [id], onDelete: Cascade)

  @@unique([turfId, name])
  @@index([turfId, active])
  @@map("package")
}
