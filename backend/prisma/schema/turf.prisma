model Turf {
  id                   String     @id @default(uuid())
  ownerId              String
  categoryId           String
  name                 String
  description          String?
  address              String
  allowAdvancePayment  Boolean    @default(false)
  advancePaymentAmount Decimal   @db.Decimal(12, 2) @default(0)
  latitude             Decimal    @db.Decimal(13, 10)
  longitude            Decimal    @db.Decimal(13, 10)
  status               TurfStatus @default(ACTIVE)
  defaultSlotDuration  Int        @default(90)
  defaultSlotPrice     Decimal    @db.Decimal(12, 2) @default(0)
  timezone             String     @default("Asia/Dhaka")
  establishedSince     DateTime   @db.Date
  /// Stored as the turf's local wall-clock value in the database.
  createdAt            DateTime   @default(now())
  /// Stored as the turf's local wall-clock value in the database.
  updatedAt            DateTime   @updatedAt

  packages            Package[]
  reviews             Review[]
  facilities          TurfFacility[]
  images              TurfImage[]
  managers            TurfManager[]
  priceRules          TurfPriceRule[]
  slots               TurfSlot[]
  paymentPhoneNumbers PaymentPhoneNumber[]
  category            TurfCategory         @relation(fields: [categoryId], references: [id])
  owner               User                 @relation(fields: [ownerId], references: [id])

  @@index([ownerId, status])
  @@index([categoryId, status])
  @@map("turf")
}

model SlotTimeSetup {
  id           String  @id @default(uuid())
  timeName     String
  startMinute  Int
  endMinute    Int
  isPeakTime   Boolean @default(false)
  slotDuration Int     @default(90)
  ownerId      String
  owner        User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  turfPriceRules TurfPriceRule[]

  @@unique([startMinute, endMinute, timeName, ownerId])
  @@index([startMinute, endMinute, timeName, ownerId])
  @@map("slot_time_setup")
}

model PaymentPhoneNumber {
  id        String        @id @default(uuid())
  turfId    String
  number    String
  method    PaymentMethod
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  turf Turf @relation(fields: [turfId], references: [id], onDelete: Cascade)

  @@unique([turfId, method])
  @@index([turfId])
  @@map("payment_phone_number")
}

model TurfPriceRule {
  id              String  @id @default(uuid())
  turfId          String
  slotTimeSetupId String
  dayOfWeek       Int
  price           Decimal @db.Decimal(12, 2)  @default(0)
  active          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slotTimeSetup SlotTimeSetup @relation(fields: [slotTimeSetupId], references: [id])
  turf          Turf          @relation(fields: [turfId], references: [id], onDelete: Cascade)

  @@unique([turfId, dayOfWeek, slotTimeSetupId])
  @@index([turfId, dayOfWeek, slotTimeSetupId])
  @@map("turf_price_rule")
}

model TurfSlot {
  id           String        @id @default(uuid())
  turfId       String
  slotDate     DateTime      @db.Date
  startMinute  Int
  endMinute    Int
  price        Decimal       @db.Decimal(12, 2)  @default(0)
  active       Boolean       @default(true)
  slotStatus   SlotSatus     @default(AVAILABLE)
  isPeakTime   Boolean       @default(false)
  /// Stored as the related turf's local wall-clock value in the database.
  createdAt    DateTime      @default(now())
  /// Stored as the related turf's local wall-clock value in the database.
  updatedAt    DateTime      @updatedAt
  turf         Turf          @relation(fields: [turfId], references: [id], onDelete: Cascade)
  bookingLinks BookingSlot[]

  @@unique([turfId, slotDate, startMinute, endMinute])
  @@index([turfId, slotDate, active])
  @@index([turfId, slotDate, slotStatus])
  @@map("turf_slot")
}

model TurfImage {
  id        String   @id @default(uuid())
  turfId    String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  turf      Turf     @relation(fields: [turfId], references: [id], onDelete: Cascade)

  @@index([turfId, sortOrder])
  @@map("turf_image")
}

model Package {
  id          String            @id @default(uuid())
  turfId      String
  name        String
  description String?
  price       Decimal           @db.Decimal(12, 2) @default(0)
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  facilities  PackageFacility[]
  turf        Turf              @relation(fields: [turfId], references: [id], onDelete: Cascade)

  @@unique([turfId, name])
  @@index([turfId, active])
  @@map("package")
}
