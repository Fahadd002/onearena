model TurfCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  turfs     Turf[]
}

model Facility {
  id                String            @id @default(uuid())
  name              String            @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  packageFacilities PackageFacility[]
  turfs             TurfFacility[]
}

model TurfImage {
  id        String   @id @default(uuid())
  turfId    String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  turf      Turf     @relation(fields: [turfId], references: [id], onDelete: Cascade)

  @@index([turfId, sortOrder])
  @@map("turf_image")
}

model Package {
  id          String            @id @default(uuid())
  turfId      String
  name        String
  description String?
  price       Decimal           @db.Decimal(12, 2)
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  facilities  PackageFacility[]
  turf        Turf              @relation(fields: [turfId], references: [id], onDelete: Cascade)

  @@unique([turfId, name])
  @@index([turfId, active])
  @@map("package")
}

model PackageFacility {
  packageId  String
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  package    Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@id([packageId, facilityId])
  @@map("package_facilitie")
}

model Turf {
  id          String     @id @default(uuid())
  ownerId     String
  categoryId  String
  name        String
  description String?
  address     String
  latitude    Decimal    @db.Decimal(13, 10)
  longitude   Decimal    @db.Decimal(13, 10)
  status      TurfStatus @default(ACTIVE)
  basePrice   Decimal    @db.Decimal(12, 2)
  slotMinutes Int        @default(90)
  timezone    String     @default("Asia/Dhaka")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  packages   Package[]
  reviews    Review[]
  facilities TurfFacility[]
  images     TurfImage[]
  managers   TurfManager[]
  priceRules TurfPriceRule[]
  slots      TurfSlot[]
  category   TurfCategory    @relation(fields: [categoryId], references: [id])
  owner      User            @relation(fields: [ownerId], references: [id])

  @@index([ownerId, status])
  @@index([categoryId, status])
  @@map("turf")
}

model TurfFacility {
  turfId     String
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  turf       Turf     @relation(fields: [turfId], references: [id], onDelete: Cascade)

  @@id([turfId, facilityId])
  @@map("turf_facilitie")
}

model TurfPriceRule {
  id          String   @id @default(uuid())
  turfId      String
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  price       Decimal  @db.Decimal(12, 2)
  active      Boolean  @default(true)
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  turf        Turf     @relation(fields: [turfId], references: [id], onDelete: Cascade)

  @@unique([turfId, dayOfWeek, startDate, endDate, startMinute, endMinute])
  @@index([turfId, dayOfWeek, startDate, endDate, startMinute, endMinute])
  @@map("turf_price_rule")
}

model TurfSlot {
  id          String    @id @default(uuid())
  turfId      String
  slotDate    DateTime  @db.Date
  startMinute Int
  endMinute   Int
  price       Decimal   @db.Decimal(12, 2)
  active      Boolean   @default(true)
  slotStatus  SlotSatus @default(AVAILABLE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  turf        Turf      @relation(fields: [turfId], references: [id], onDelete: Cascade)
  booking     Booking?

  @@unique([turfId, slotDate, startMinute, endMinute])
  @@index([turfId, slotDate, active])
  @@index([turfId, slotDate, slotStatus])
  @@map("turf_slot")
}

model Booking {
  id               String        @id @default(uuid())
  bookingNumber    String        @unique @default(cuid())
  userId           String
  slotId           String        @unique
  mobile           String?
  status           BookingStatus @default(PREBOOKED)

  baseAmount       Decimal @db.Decimal(12, 2)
  packageAmount    Decimal @default(0) @db.Decimal(12, 2)
  discountAmount   Decimal @default(0) @db.Decimal(12, 2)
  subtotal         Decimal @db.Decimal(12, 2)
  totalAmount      Decimal @db.Decimal(12, 2)

  bookingExpiresAt DateTime?
  idempotencyKey   String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  slot TurfSlot @relation(fields: [slotId], references: [id])

  // One Booking has zero or one Invoice
  invoice BookingInvoice?

  refunds Refund[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([bookingExpiresAt])
  @@map("booking")
}

model BookingInvoice {
  id            String        @id @default(uuid())
  bookingId     String        @unique
  invoiceNumber String        @unique
  invoiceDate   DateTime      @default(now())

  subtotal    Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)
  paidAmount  Decimal @default(0) @db.Decimal(12, 2)

  isFullPaid Boolean      @default(false)
  status     PaymentStatus @default(UNPAID)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  payments Payment[]

  @@map("booking_invoice")
}


model Payment {
  id            String         @id @default(uuid())
  paymentNumber String         @unique
  invoiceId     String
  invoice       BookingInvoice @relation(fields: [invoiceId], references: [id])
  paidAmount    Decimal        @default(0) @db.Decimal(12, 2)
  type          PaymentType
  method        PaymentMethod
  amount        Decimal        @db.Decimal(12, 2)
  status        PaymentStatus  @default(PENDING)

  // Online payment gateway information
  providerTransactionId String? @unique
  paymentIntentId       String? @unique
  checkoutSessionId     String? @unique

  // Prevent duplicate payment processing
  idempotencyKey String @unique

  // Gateway webhook/event ID
  rawEventId String? @unique

  // Manual payment information
  receivedById String?
  reference    String?
  note         String?

  paidAt DateTime?

  failureCode    String?
  failureMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receivedBy User? @relation("PaymentReceivedBy", fields: [receivedById], references: [id])

  refunds Refund[]

  @@index([invoiceId, paidAt])
  @@map("payment")
}

model Refund {
  id String @id @default(uuid())

  paymentId String
  bookingId String

  amount Decimal @db.Decimal(12, 2)

  reason String?

  status RefundStatus @default(REQUESTED)

  requestedBy String
  processedBy String?

  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([paymentId, status])
  @@index([bookingId, status])
  @@map("refund")
}

model Review {
  id        String        @id @default(uuid())
  bookingId String        @unique
  userId    String
  turfId    String
  rating    Int
  comment   String?
  isHidden  Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  turf      Turf          @relation(fields: [turfId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies   ReviewReply[]

  @@index([turfId, rating])
  @@index([userId])
  @@map("review")
}

model ReviewReply {
  id        String   @id @default(uuid())
  reviewId  String
  userId    String
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_reply")
}
